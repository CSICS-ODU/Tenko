# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# ---------------------------------------------------------------------------
# Public release: GitHub tracks only the top-level README.md as markdown.
# Local memo / experiment write-ups may remain on disk but stay untracked.
# ---------------------------------------------------------------------------
*.md
!/README.md

# ---------------------------------------------------------------------------
# Public release (public-release branch): exclude large / raw / regenerable
# artifacts. See the top-level README.md reproducibility section for how to
# obtain or regenerate these.
# ---------------------------------------------------------------------------
# Extra virtualenvs (only .venv is covered above)
.venv314/
.venv_mateen/
.venv_vae/
# macOS / office cruft
.DS_Store
*.DS_Store
**/.DS_Store
~$*.docx
*.pptx
# matplotlib font cache written next to figure scripts (never publish)
**/mplcache/
# scratch/debug logs (also covered by *.log above; kept explicit for clarity)
*.log
# Vendored upstream baseline source (Kitsune/Mateen/VAEESDD/etc.).
# Attribution + upstream URLs are documented in REPRODUCIBILITY.md.
external/
# Raw packet captures and their TSV conversions (derived from CICIoT2023,
# which requires registration to download). Multi-GB; regenerable from PCAP.
*.pcap
*.pcapng
*.pcap.tsv
results/CICIoT2023/**/*.tsv
# Large per-packet feature matrices (regenerable from TSV via extract_features.py)
results/CICIoT2023/baselines/features/*.npy
# Re-balance side-experiment (not used by any headline table; bulk streams)
results/CICIoT2023/mixed/rebal/
# Duplicate VAEESDD score archive (kept: baselines/vaeesdd/vaeesdd_*.npz)
results/CICIoT2023/baselines/vaeesdd/streaming_baseline/

# workflow.py local layer CSVs (not measured latency)
_local_dev_layers/
**/_local_dev_layers/
